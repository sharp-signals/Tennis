{
  "schema_version": 1,
  "contract_version": "contextual-shadow-report-v2.0",
  "model_version": "contextual-family-shadow-v2",
  "mode": "SHADOW_PREVIEW_ONLY",
  "sections": [
    "match_context",
    "pricing_core",
    "market_benchmark",
    "human_market_review",
    "handicap_evidence",
    "family_map",
    "evidence_quality",
    "technical_trace"
  ],
  "family_order": [
    "recent_form",
    "structural_strength",
    "surface_conditions",
    "matchup_h2h",
    "serve_return"
  ],
  "rules": {
    "market_must_not_enter_model_probability": true,
    "market_capture_must_follow_prediction": true,
    "handicap_evidence_must_be_frozen_with_prediction": true,
    "handicap_requires_own_line_probability": true,
    "missing_market_remains_not_available": true,
    "missing_family_is_not_neutral_evidence": true,
    "observed_none_is_distinct_from_unavailable": true,
    "no_betting_recommendation": true,
    "no_paper_green_or_notification": true,
    "no_automatic_publication": true
  }
}
